{
  "name": "Sonaris",
  "description": "Sonaris adds real-time captions and translation to any tab.",
  "version": "1.0.0",
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png",
      "48": "icons/logo-48.png",
      "128": "icons/logo-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src http://127.0.0.1:8000/ https://*.supabase.co https://captifylanding.netlify.app https://floral-dust-d2f5.vinaybhardwaj2334.workers.dev https://api.sonaris.cc" 
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["tabCapture", "offscreen", "downloads", "scripting", "activeTab", "storage", "identity"],
  "host_permissions": ["http://127.0.0.1:8000/*", "https://*.supabase.co/*", "https://captifylanding.netlify.app/*", "https://floral-dust-d2f5.vinaybhardwaj2334.workers.dev/*", "https://api.sonaris.cc/*"],
  "web_accessible_resources": [
    {
      "resources": ["recorder-processor.js", "icons/logo-overlay.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
